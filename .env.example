# ============================================================
# ADA — переменные окружения
# Скопируйте в .env и заполните значения. Файл .env не коммитится.
# ============================================================

# --- Домен и публичные настройки (встраиваются в frontend при сборке) ---
NEXT_PUBLIC_SITE_URL=https://ada-ai.ru
# ID аналитики (можно оставить пустыми — тогда скрипты не подключаются)
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
# Коды подтверждения владения сайтом
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- PostgreSQL ---
POSTGRES_DB=ada
POSTGRES_USER=ada
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
APP_ENV=production
LOG_LEVEL=INFO
# Для локального запуска без Docker:
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://ada:password@localhost:5432/ada
DATABASE_URL=postgresql+asyncpg://ada:change-me-strong-password@db:5432/ada
TRUST_PROXY_HEADERS=true
MAX_REQUEST_BYTES=64000

# CORS: адреса, с которых разрешены запросы к API (через запятую)
CORS_ORIGINS=https://ada-ai.ru,https://www.ada-ai.ru

# Rate limiting
RATE_LIMIT_LEADS=5
RATE_LIMIT_CHAT=30
RATE_LIMIT_WINDOW_SECONDS=600
MIN_FORM_FILL_MS=1500

# --- Telegram-уведомления о заявках ---
# 1. Создайте бота через @BotFather, получите токен
# 2. Напишите боту /start и узнайте chat_id через getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM-провайдер AI-консультанта ---
# openai — OpenAI и любые OpenAI-совместимые API (OpenRouter, DeepSeek, локальные)
# anthropic — Claude Messages API
# disabled — консультант выключен
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900
LLM_MAX_HISTORY_MESSAGES=16

# --- Админ-API (заявки, статусы) ---
# Сгенерируйте: openssl rand -hex 32
ADMIN_TOKEN=
